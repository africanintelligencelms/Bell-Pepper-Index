# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional override for the model used by the WhatsApp extractor
# and the market intelligence panel.
# GEMINI_MODEL="gemini-3.6-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: Postgres connection string (Neon or Supabase).
# Use the POOLED endpoint in production — serverless functions open many short
# connections and will exhaust a direct endpoint's limit.
#   Neon:     postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
#   Supabase: postgresql://postgres.ref:pass@aws-0-region.pooler.supabase.com:6543/postgres
# Leave unset to run against the in-memory store (data is lost on restart).
DATABASE_URL=""

# PGSSLMODE: Set to "disable" only for a local Postgres without TLS.
# PGSSLMODE="disable"

# PG_POOL_MAX: Connections per serverless instance. Keep small; default 3.
# PG_POOL_MAX="3"

# ADMIN_TOKEN: Required for destructive and configuration endpoints —
# DELETE /api/prices/:id, POST /api/prices/reset, and all price-band / COP writes.
# Send it as the "x-admin-token" header. Unset means those endpoints return 503.
ADMIN_TOKEN=""

# RATE_LIMIT_PARSE_PER_HOUR / RATE_LIMIT_PREDICT_PER_HOUR: per-IP hourly caps on
# the Gemini-backed endpoints. These are public routes that each cost quota, so
# the limiter is what stops a stranger draining the project's allowance.
# Defaults: 15 and 60.
# RATE_LIMIT_PARSE_PER_HOUR="15"
# RATE_LIMIT_PREDICT_PER_HOUR="60"

# RATE_LIMIT_SUBMIT_PER_HOUR / RATE_LIMIT_BULK_PER_HOUR /
# RATE_LIMIT_OFFTAKER_PER_HOUR: per-IP hourly caps on the public write
# endpoints. Submission is unauthenticated so contributing stays frictionless,
# which is also how a buyer could flood the index with low sales to drag the
# published median down. Sized loosely because Nigerian mobile networks put
# many subscribers behind one address. A valid ADMIN_TOKEN bypasses all three.
# Defaults: 30, 5 and 15.
# RATE_LIMIT_SUBMIT_PER_HOUR="30"
# RATE_LIMIT_BULK_PER_HOUR="5"
# RATE_LIMIT_OFFTAKER_PER_HOUR="15"
